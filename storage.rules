rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Organizations logos
    match /organizations/{orgId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.role in ['ADMIN', 'ORGANIZER']
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Teams logos
    match /teams/{teamId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.role in ['ADMIN', 'ORGANIZER']
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Persons photos
    match /persons/{personId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.token.personId == personId
                       || request.auth.token.role in ['ADMIN', 'ORGANIZER'])
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Venues photos
    match /venues/{venueId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.role in ['ADMIN', 'ORGANIZER']
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Competitions banners
    match /competitions/{competitionId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.role in ['ADMIN', 'ORGANIZER']
                   && request.resource.size < 3 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
